// aritmetica, precedencia, unarios, comparaciones y concatenacion
let a: integer = 10;
let b: integer = 3;
let c: integer = 2;
let r1: integer = a + b * c - a / b % c;
let r2: integer = -(a - b) * -c;
let menor: boolean = a < b;
let distinto: boolean = a + 1 != b * c;
let mayorIgual: boolean = a >= c;
let saludo: string = "hola " + "mundo";
let negado: boolean = !menor;
