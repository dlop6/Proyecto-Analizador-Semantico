// concatenacion con string, integer y boolean; igualdad por contenido
let nombre: string = "Ada";
let edad: integer = 36;
let mayor: boolean = edad >= 18;
let frase: string = nombre + " tiene " + edad + " anios";
print(frase);
print("mayor de edad: " + mayor);
print(edad + " es la edad");
print(false + " al inicio");
let copia: string = "Ada";
let armada: string = "A" + "d" + "a";
print(nombre == copia);
print(nombre == armada);
print(nombre != "ada");
print("" + -7);
let vacia: string;
print(vacia);
print("x" + vacia);
